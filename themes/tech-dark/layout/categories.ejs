<div class="container listing-page"><header class="listing-header"><p class="eyebrow">INDEX / CATEGORIES</p><h1>文章分类</h1><p>按主题整理的文章入口。</p></header><div class="taxonomy-grid"><% if (site.categories && site.categories.length) { site.categories.sort('name').each(function(category) { %><a class="taxonomy-card" href="<%= url_for(category.path) %>"><strong><%= category.name %></strong><span><%= category.length %> 篇文章 ↗</span></a><% }) } else { %><div class="empty-state">还没有分类。</div><% } %></div></div>
