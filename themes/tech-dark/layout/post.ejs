<% var readingMinutes = Math.max(1, Math.ceil(strip_html(page.content).replace(/\s+/g, '').length / 500)); %><% var articleToc = toc(page.content, { list_number: false }); %><article class="container article-layout"><div class="article-main"><header class="article-header"><div class="post-meta"><time datetime="<%= page.date.toISOString() %>"><%= date(page.date, 'YYYY.MM.DD') %></time><% if (page.categories && page.categories.length) { %><span class="meta-divider">/</span><a href="<%= url_for(page.categories.first().path) %>"><%= page.categories.first().name %></a><% } %><span class="meta-divider">/</span><span>预计阅读 <%= readingMinutes %> 分钟</span></div><h1><%= page.title %></h1><% if (page.tags && page.tags.length) { %><div class="article-tags"><% page.tags.each(function(tag) { %><a href="<%= url_for(tag.path) %>">#<%= tag.name %></a><% }) %></div><% } %></header><% if (articleToc) { %><nav class="article-toc article-toc-mobile" aria-label="文章目录"><p class="eyebrow">CONTENTS</p><%- articleToc %></nav><% } %><div class="article-content"><%- page.content %></div><nav class="post-nav" aria-label="文章导航"><% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>"><small>上一篇</small><span>← <%= page.prev.title %></span></a><% } else { %><span></span><% } %><% if (page.next) { %><a class="next" href="<%= url_for(page.next.path) %>"><small>下一篇</small><span><%= page.next.title %> →</span></a><% } %></nav></div><aside class="article-aside"><div class="author-card compact"><img src="<%= url_for(theme.avatar || '/images/avatar.png') %>" alt="<%= config.author %> 的头像"><strong><%= config.author || '米饭' %></strong><p><%= config.description || '天行健，君子以自强不息。' %></p></div><a class="back-link" href="<%= url_for('/') %>">← 返回首页</a><% if (articleToc) { %><nav class="article-toc article-toc-desktop" aria-label="文章目录"><p class="eyebrow">CONTENTS</p><%- articleToc %></nav><% } %><div class="reading-note"><span>阅读提示</span><p>慢一点读，留一点时间给思考。</p></div></aside></article>
