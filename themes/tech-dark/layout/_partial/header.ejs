<header class="site-header"><div class="container nav-wrap"><a class="brand" href="<%= url_for('/') %>" aria-label="返回首页"><span class="brand-mark">&gt;_</span><span><%= theme.site_label || config.title %></span></a><nav class="main-nav" aria-label="主导航"><% Object.keys(theme.menu || {}).forEach(function(label) { %><a href="<%= url_for(theme.menu[label]) %>"><%= label %></a><% }) %></nav><a class="icon-button search-link" href="<%= url_for('/search/') %>" aria-label="搜索文章" title="搜索文章">⌕</a><button class="icon-button" type="button" data-theme-toggle aria-label="切换主题" title="切换主题">◐</button></div></header>
