<div class="container listing-page"><header class="listing-header"><p class="eyebrow">INDEX / TAGS</p><h1>文章标签</h1><p>用标签串起不同文章之间的联系。</p></header><div class="taxonomy-grid"><% if (site.tags && site.tags.length) { site.tags.sort('name').each(function(tag) { %><a class="taxonomy-card" href="<%= url_for(tag.path) %>"><strong>#<%= tag.name %></strong><span><%= tag.length %> 篇文章 ↗</span></a><% }) } else { %><div class="empty-state">还没有标签。</div><% } %></div></div>
