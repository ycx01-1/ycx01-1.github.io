<section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="pulse-dot"></span><%= theme.hero_kicker || 'BUILD IN PUBLIC' %></p><h1><%= theme.hero_title || '把想法写下来，' %><br><span><%= theme.hero_title_accent || '把代码做出来。' %></span></h1><p class="hero-description"><%= theme.hero_description || config.description %></p><div class="hero-actions"><a class="button button-primary" href="#latest">阅读最新文章 <span>↓</span></a><a class="text-link" href="<%= url_for('/about/') %>">了解我 <span>↗</span></a></div></div><div class="hero-terminal" aria-label="博客状态"><div class="terminal-bar"><span></span><span></span><span></span><b>~/notes/status</b></div><div class="terminal-body"><p><i>const</i> status = {</p><p class="indent"><span>focus:</span> <em>"build useful things"</em>,</p><p class="indent"><span>current:</span> <em>"learning in public"</em>,</p><p class="indent"><span>energy:</span> <strong>100</strong></p><p>};</p><p class="terminal-cursor">▌</p></div></div></section>
<section id="latest" class="container content-grid"><div class="posts-column"><div class="section-heading"><div><p class="eyebrow">01 / JOURNAL</p><h2>最新文章</h2></div><span class="heading-line"></span></div><% if (page.posts && page.posts.length) { %><div class="post-list"><% page.posts.each(function(post) { %><article class="post-card"><div class="post-meta"><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'YYYY.MM.DD') %></time><% if (post.categories && post.categories.length) { %><span class="meta-divider">/</span><span><%= post.categories.first().name %></span><% } %></div><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= post.excerpt ? strip_html(post.excerpt).slice(0, 150) : '' %></p><a class="read-more" href="<%= url_for(post.path) %>">阅读全文 <span>↗</span></a></article><% }) %></div><% } else { %><div class="empty-state">还没有文章，第一篇内容正在路上。</div><% } %></div><aside class="sidebar"><div class="sidebar-block about-mini"><p class="eyebrow">02 / ABOUT</p><h3>你好，我是 <%= config.author || '米饭' %>。</h3><p><%= config.description || '天行健，君子以自强不息。' %></p><a class="text-link" href="<%= url_for('/about/') %>">更多关于我 ↗</a></div><div class="sidebar-block"><p class="eyebrow">03 / TOPICS</p><div class="tag-cloud"><% site.categories.sort('length', -1).limit(8).each(function(category) { %><a href="<%= url_for(category.path) %>"><%= category.name %><small><%= category.length %></small></a><% }) %></div></div><div class="sidebar-block"><p class="eyebrow">04 / FIND ME</p><div class="social-links"><% if (theme.social && theme.social.github) { %><a href="<%= theme.social.github %>">GitHub ↗</a><% } %><% if (theme.social && theme.social.email) { %><a href="mailto:<%= theme.social.email %>">Email ↗</a><% } %><% if ((!theme.social || (!theme.social.github && !theme.social.email))) { %><span class="muted">社交链接待补充</span><% } %></div></div></aside></section>
