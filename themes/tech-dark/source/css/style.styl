:root
  --bg #0b1114
  --surface #101a1e
  --surface-2 #142126
  --text #edf5f1
  --muted #8da39d
  --line #27383a
  --accent #80ed99
  --max 1180px
:root[data-theme='light']
  --bg #f4f7f4
  --surface #fff
  --surface-2 #e9f1ed
  --text #182522
  --muted #587069
  --line #ccd9d4
  --accent #18794e
*
  box-sizing border-box
html
  scroll-behavior smooth
body
  margin 0
  background var(--bg)
  color var(--text)
  font-family 'Space Grotesk', system-ui, sans-serif
  line-height 1.7
a
  color inherit
  text-decoration none
.container
  width min(calc(100% - 48px), var(--max))
  margin 0 auto
.skip-link
  position absolute
  left -9999px
  &:focus
    left 16px
    top 16px
    z-index 10
    padding 8px 12px
    background var(--accent)
    color #07110d
.site-header
  border-bottom 1px solid var(--line)
  background var(--bg)
  position sticky
  top 0
  z-index 5
.nav-wrap
  min-height 74px
  display flex
  align-items center
  gap 28px
.brand
  display flex
  align-items center
  gap 10px
  margin-right auto
  font-family 'IBM Plex Mono', monospace
  font-size 13px
  font-weight 600
.brand-mark, .eyebrow, .text-link, .read-more, .post-meta, .main-nav, .button, .back-link
  font-family 'IBM Plex Mono', monospace
.brand-mark, .eyebrow, .text-link, .read-more
  color var(--accent)
.main-nav
  display flex
  gap 22px
  font-size 12px
  color var(--muted)
  a:hover
    color var(--accent)
.icon-button
  width 40px
  height 40px
  border 1px solid var(--line)
  background transparent
  color var(--accent)
  cursor pointer
  border-radius 5px
.search-link
  display inline-flex
  align-items center
  justify-content center
.search-box
  display flex
  align-items center
  gap 12px
  max-width 720px
  margin-top 34px
  padding 14px 16px
  border 1px solid var(--line)
  background var(--surface)
  color var(--accent)
  input
    width 100%
    border 0
    outline 0
    background transparent
    color var(--text)
    font: inherit
    &::placeholder
      color var(--muted)
.search-results
  display grid
  gap 12px
  max-width 720px
  padding-top 24px
.search-result
  display grid
  gap 6px
  padding 18px
  border 1px solid var(--line)
  background var(--surface)
  &:hover
    border-color var(--accent)
  time
    color var(--muted)
    font-family 'IBM Plex Mono', monospace
    font-size 11px
  strong
    font-size 19px
  span
    color var(--muted)
    font-size 14px
.hero
  display grid
  grid-template-columns 1.1fr .9fr
  gap 72px
  padding-top 108px
  padding-bottom 116px
  align-items center
.eyebrow
  font-size 11px
  letter-spacing .12em
  margin 0 0 16px
.pulse-dot
  display inline-block
  width 7px
  height 7px
  margin-right 8px
  border-radius 50%
  background var(--accent)
.hero h1
  font-size clamp(42px, 6vw, 78px)
  line-height 1.08
  letter-spacing -.055em
  margin 0
.hero h1 span
  color var(--accent)
.hero-description
  max-width 500px
  color var(--muted)
  font-size 17px
  margin 26px 0 32px
.hero-actions
  display flex
  align-items center
  gap 26px
.button
  display inline-flex
  gap 20px
  padding 12px 16px
  border-radius 4px
  font-size 12px
.button-primary
  background var(--accent)
  color #07110d
.hero-terminal
  background var(--surface)
  border 1px solid var(--line)
  border-radius 7px
  box-shadow 18px 18px 0 rgba(128,237,153,.05)
  transform rotate(1.5deg)
.terminal-bar
  display flex
  align-items center
  gap 6px
  padding 13px 16px
  border-bottom 1px solid var(--line)
  color var(--muted)
  font-family 'IBM Plex Mono', monospace
  font-size 10px
.terminal-bar span
  width 8px
  height 8px
  border-radius 50%
  background var(--line)
.terminal-bar b
  margin-left 8px
  font-weight 400
.terminal-body
  padding 28px 26px 34px
  font-family 'IBM Plex Mono', monospace
  font-size 13px
  color var(--muted)
  p
    margin 7px 0
  i, span
    color #c792ea
    font-style normal
  em
    color var(--accent)
    font-style normal
  strong
    color #f6c177
  .indent
    padding-left 22px
.content-grid
  display grid
  grid-template-columns minmax(0, 1fr) 300px
  gap 100px
  padding-bottom 110px
.section-heading
  display flex
  align-items center
  gap 28px
  margin-bottom 28px
  h2
    font-size 28px
    margin 0
.section-heading .eyebrow
  margin-bottom 7px
.heading-line
  height 1px
  flex 1
  background var(--line)
.post-card
  padding 26px 0 30px
  border-top 1px solid var(--line)
  h3
    font-size 24px
    line-height 1.25
    margin 9px 0
    a:hover
      color var(--accent)
  p
    color var(--muted)
    margin 0 0 16px
.post-meta
  color var(--muted)
  font-size 11px
.meta-divider
  color var(--line)
  margin 0 8px
.sidebar
  border-left 1px solid var(--line)
  padding-left 30px
.sidebar-block
  margin-bottom 48px
  h3
    font-size 20px
    line-height 1.35
    margin 0 0 12px
  p:not(.eyebrow)
    color var(--muted)
    font-size 14px
    margin 0 0 16px
.tag-cloud
  display flex
  flex-wrap wrap
  gap 8px
  a
    padding 7px 9px
    border 1px solid var(--line)
    color var(--muted)
    font-family 'IBM Plex Mono', monospace
    font-size 11px
    &:hover
      border-color var(--accent)
      color var(--accent)
  small
    color var(--accent)
.social-links
  display flex
  flex-direction column
  gap 8px
  font-family 'IBM Plex Mono', monospace
  font-size 12px
.muted
  color var(--muted)
.empty-state
  border 1px dashed var(--line)
  padding 28px
  color var(--muted)
.site-footer
  border-top 1px solid var(--line)
  color var(--muted)
  font-family 'IBM Plex Mono', monospace
  font-size 11px
.footer-inner
  display flex
  justify-content space-between
  padding 24px 0
.footer-prompt
  color var(--accent)
.article-layout
  display grid
  grid-template-columns minmax(0, 760px) 1fr
  gap 90px
  padding-top 86px
  padding-bottom 110px
.article-header
  padding-bottom 36px
  border-bottom 1px solid var(--line)
  h1
    font-size clamp(36px, 5vw, 60px)
    line-height 1.12
    margin 16px 0 18px
.article-tags
  display flex
  gap 9px
  a
    color var(--accent)
    font-family 'IBM Plex Mono', monospace
    font-size 11px
.article-content
  padding-top 36px
  font-size 17px
  line-height 1.9
  h2, h3, h4
    line-height 1.3
    margin-top 42px
  a
    color var(--accent)
    text-decoration underline
  blockquote
    border-left 2px solid var(--accent)
    margin 30px 0
    padding 2px 22px
    color var(--muted)
  code
    padding 2px 6px
    background var(--surface-2)
    color var(--accent)
    font-family 'IBM Plex Mono', monospace
    font-size .82em
  pre
    overflow-x auto
    padding 22px
    border 1px solid var(--line)
    background var(--surface)
    code
      padding 0
      background transparent
  table
    width 100%
    margin 28px 0 34px
    border-collapse separate
    border-spacing 0
    border: 1px solid var(--line)
    background var(--surface)
    font-size .92em
    line-height 1.6
    overflow: hidden
  th, td
    padding 13px 16px
    text-align left
    vertical-align top
    border-right 1px solid var(--line)
    border-bottom 1px solid var(--line)
  th
    color var(--accent)
    background var(--surface-2)
    font-family 'IBM Plex Mono', monospace
    font-size .82em
    font-weight 600
    white-space nowrap
  td
    color var(--muted)
  th:last-child, td:last-child
    border-right 0
  tr:last-child td
    border-bottom 0
.article-aside
  padding-top 8px
.back-link
  color var(--accent)
  font-size 12px
.reading-note
  border-top 1px solid var(--line)
  margin-top 42px
  padding-top 18px
  color var(--muted)
  font-size 13px
.post-nav
  display grid
  grid-template-columns 1fr 1fr
  gap 20px
  margin-top 72px
  padding-top 24px
  border-top 1px solid var(--line)
  a
    display flex
    flex-direction column
    gap 5px
  .next
    text-align right
  small
    color var(--muted)
    font-family 'IBM Plex Mono', monospace
    font-size 10px
.listing-page
  padding-top 86px
  padding-bottom 110px
.listing-header
  padding-bottom 40px
  border-bottom 1px solid var(--line)
  h1
    font-size clamp(38px, 5vw, 60px)
    margin 0 0 8px
  p:not(.eyebrow)
    color var(--muted)
.archive-list
  padding-top 8px
.taxonomy-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 14px
  padding-top 34px
.taxonomy-card
  display flex
  flex-direction column
  gap 8px
  padding 20px
  border 1px solid var(--line)
  background var(--surface)
  transition border-color .2s ease, transform .2s ease
  strong
    font-size 18px
  span
    color var(--muted)
    font-family 'IBM Plex Mono', monospace
    font-size 11px
  &:hover
    border-color var(--accent)
    transform translateY(-2px)
.archive-row
  display grid
  grid-template-columns 130px 1fr 24px
  gap 20px
  align-items center
  padding 20px 0
  border-bottom 1px solid var(--line)
  time
    color var(--muted)
    font-family 'IBM Plex Mono', monospace
    font-size 11px
  span
    color var(--muted)
@media (max-width: 800px)
  .container
    width calc(100% - 32px)
  .main-nav
    display none
  .hero
    grid-template-columns 1fr
    gap 48px
    padding-top 72px
    padding-bottom 80px
  .hero-terminal
    transform none
  .content-grid, .article-layout
    grid-template-columns 1fr
    gap 50px
  .sidebar
    border-left 0
    border-top 1px solid var(--line)
    padding-left 0
    padding-top 35px
  .article-layout, .listing-page
    padding-top 55px
  .archive-row
    grid-template-columns 92px 1fr 16px
    gap 12px
  .taxonomy-grid
    grid-template-columns 1fr
  .article-content
    table
      display block
      max-width 100%
      overflow-x auto
      -webkit-overflow-scrolling touch
    th, td
      min-width 120px
      padding 11px 13px
  .footer-inner
    flex-direction column
    gap 8px
